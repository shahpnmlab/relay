@using Relay.Emoji
@using Refund.Components.Emoji

<FluentDialogBody>
<EditForm Model="@Model" OnValidSubmit="OnCreateClick">
    <DataAnnotationsValidator />

    <div>
        <div class="form-content">
            <div style="width: 100%; display: flex; align-items: center; justify-content: center;">
                <EmojiSelectionButton Position="Positioning.Below" @bind-Glyph="Model.HeroImage"
                                      Size="64"
                                      ShowBorder="true" />
            </div>

            <div class="form-item">
                <RelayTextInput @bind-Value="Model.Name"
                                 Label="Project name"
                                 Required="true"
                                 Immediate="true"
                                 Autofocus="true"
                                 AutoComplete="off"/>
                <FluentValidationMessage For="@(() => Model.Name)"/>
            </div>

            <div class="form-item">
                <RelayTextInput @bind-Value="Model.Notes"
                                 Label="Notes"
                                 Immediate="true"
                                 AutoComplete="off"/>
                <FluentValidationMessage For="@(() => Model.Notes)"/>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="error-message">@ErrorMessage</div>
            }
        </div>
    </div>

    <div>
        <FluentButton Type="ButtonType.Button"
                      Appearance="ButtonAppearance.Outline"
                      OnClick="OnCancelClick">
            Cancel
        </FluentButton>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary">
            Create
        </FluentButton>
    </div>
</EditForm>
</FluentDialogBody>