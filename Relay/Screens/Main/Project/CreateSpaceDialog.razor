@using Refund.Components.FileBrowser
@using Relay.Emoji
@using Refund.Components.Emoji
<FluentDialogBody>
<EditForm OnValidSubmit="@OnFormSubmit" EditContext="FormContext">
    <DataAnnotationsValidator />

    <div>
        <div class="form-content">
            <div style="width: 100%; display: flex; align-items: center; justify-content: center;">
                <EmojiSelectionButton Position="Positioning.Below" @bind-Glyph="Model.HeroImage"
                                      Size="64"
                                      ShowBorder="true"
                                      Disabled="@Model.IsReconnectMode"/>
            </div>

            <div class="form-item">
                <FluentTextInput @bind-Value="Model.Name"
                                 Label="Space name"
                                 Required="true"
                                 Immediate="true"
                                 Autofocus="true"
                                 AutoComplete="off"
                                 Disabled="@Model.IsReconnectMode"/>
                <FluentValidationMessage For="@(() => Model.Name)"/>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="error-message">@ErrorMessage</div>
                }
            </div>
            <div class="form-item">
                <FluentTextInput @bind-Value="Model.Notes"
                                 Label="Notes"
                                 Immediate="true"
                                 AutoComplete="off"
                                 Disabled="@Model.IsReconnectMode"/>
                <FluentValidationMessage For="@(() => Model.Notes)"/>
            </div>

            <div class="form-item">
                <span>Space directory</span>
                <FileBrowser SelectionMode="SelectionMode.SingleFolder"
                             ShowSelectionButtons="false"
                             Height="400"
                             CurrentFolder="@Model.Directory"
                             CurrentFolderChanged="@(async (val) =>
                                                   {
                                                       Model.Directory = val;
                                                       StateHasChanged();
                                                   })"
                             CurrentFolderExpression="@(() => Model.Directory)"/>
                <FluentValidationMessage For="@(() => Model.Directory)"/>

                @if (Model.IsReconnectMode)
                {
                    <div class="reconnect-notice">
                        <span>Found existing space data in this directory. You can reconnect it to the current project.</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div>
        <FluentButton Type="ButtonType.Button"
                      Appearance="ButtonAppearance.Outline"
                      OnClick="OnCancelClick">
            Cancel
        </FluentButton>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary"
                      Disabled="@FormContext.GetValidationMessages().Any()">
            @(Model.IsReconnectMode ? "Reconnect" : "Create")
        </FluentButton>
    </div>
</EditForm>
</FluentDialogBody>
