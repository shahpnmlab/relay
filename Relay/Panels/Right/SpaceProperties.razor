@using Refund.DataModel.ReadOnly
@using Refund.Services
@using Refund.Services.Core.DataManager
@using Refund.Services.Core.Session
@using Refund.Components.FileBrowser
@using Relay.Panels.Right.Actions
@using Refund.Components.Emoji
@using Refund.DataModel
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div style="display: flex; flex-direction: column; justify-content: flex-start; row-gap: 2rem;">
    @if (Spaces.Count() == 1)
    {
        var space = Spaces.First();
        
        <div class="property-panel">
            <h5>@space.QualifiedName</h5>

            <div class="property-item">
                <span class="property-title">Name</span>
                <RelayTextInput Class="property-value"
                                 AutoComplete="off"
                                 Value="@space.Alias"
                                 ValueChanged="@HandleSpaceAliasChanged" />
                @if (!string.IsNullOrEmpty(_aliasValidationError))
                {
                    <div style="display: flex; flex-wrap: nowrap; font-size: 0.75rem; color: var(--error); gap: 0.3rem;">
                        <FluentIcon Value="@(new Icons.Filled.Size12.ErrorCircle().WithColor("var(--error)"))" />
                        <span>@_aliasValidationError</span>
                    </div>
                }
            </div>

            <div class="property-item">
                <span class="property-title">Icon</span>
                <EmojiSelectionButton Glyph="@space.HeroImage"
                                      GlyphChanged="@HandleSpaceEmojiChanged"
                                      Size="64" />
            </div>

            <div class="property-item">
                <span class="property-title">Notes</span>
                <RelayTextArea Class="property-value"
                                Height="112px"
                                Value="@space.Notes"
                                ValueChanged="@HandleSpaceNotesChanged" />
            </div>

            <div class="property-item">
                <span class="property-title">Directory</span>
                <div class="property-value" style="display: flex; flex-wrap: nowrap; align-items: center; gap: 2px;">
                    <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0;" title="@space.RootDirectory">@space.RootDirectory</div>
                    <FluentButton IconOnly="true" Appearance="ButtonAppearance.Transparent"
                                  Title="Copy to clipboard"
                                  Style="height: 16px; min-height: 16px; flex-shrink: 0; padding: 0; margin: 0; min-width: 16px;"
                                  OnClick="@HandlePathCopyClicked">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Copy())" />
                    </FluentButton>
                    <FluentButton IconOnly="true" Appearance="ButtonAppearance.Transparent"
                                  Title="Browse folder"
                                  Style="height: 16px; min-height: 16px; flex-shrink: 0; padding: 0; margin: 0; min-width: 16px;"
                                  OnClick="@HandleBrowseFolderClicked">
                        <FluentIcon Value="@(new Icons.Regular.Size16.FolderOpen())" />
                    </FluentButton>
                </div>
            </div>
            
            <div class="property-item">
                <span class="property-title">Created</span>
                <span class="property-value">
                    @space.GetMostRecentEvent(EventType.Created).Timestamp.ToString("yyyy-MM-dd HH:mm"), by 
                    <FluentBadge Class="author-badge">
                        @space.GetMostRecentEvent(EventType.Created).Author.Name
                    </FluentBadge>
                </span>
            </div>

            <div class="property-item">
                <span class="property-title">Last modified</span>
                <span class="property-value">@space.UpdateDate.ToString("yyyy-MM-dd HH:mm"), by <FluentBadge Class="author-badge">@space.UpdatedBy.Name</FluentBadge></span>
            </div>
            
            @{
                int njobs = space.Jobs.Count;
                int nviews = space.Views.Count;
            }
            <span class="property-title">@njobs jobs in @nviews views</span>
        </div>
    }
    else if (Spaces.Count() > 1)
    {
        <h5>@Spaces.Count() spaces selected</h5>
    }
        
    <ActionButtons Actions="@MenuActions.GetSpaceActions(Spaces)" />
</div>