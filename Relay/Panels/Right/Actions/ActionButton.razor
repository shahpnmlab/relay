@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@if (Action.BorderColor != null)
{
    <style>
        @($"#{_id} > fluent-button {{ border-color: {Action.BorderColor}; }}")
    </style>
}

<div id="@_id" style="width: 100%;">
    @if (!Action.SubActions.Any())
    {
        <FluentButton Disabled="@Action.IsDisabled"
                      Appearance="@Action.Appearance"
                      BackgroundColor="@Action.BackgroundColor"
                      Color="@Action.TextColor"
                      IconStart="@Action.IconLarge"
                      Style="width: 100%;"
                      OnClick="@HandlePrimaryClick">
            @Action.Name
        </FluentButton>
    }
    else
    {
        <FluentButton Disabled="@Action.IsDisabled"
                      Appearance="@Action.Appearance"
                      BackgroundColor="@Action.BackgroundColor"
                      Color="@Action.TextColor"
                      IconStart="@Action.IconLarge"
                      IconEnd="@(new Icons.Regular.Size16.ChevronDown())"
                      Style="width: 100%;"
                      OnClick="@(() => _menuOpen = !_menuOpen)">
            @Action.Name
        </FluentButton>
        <RelayMenu Anchor="@_id" @bind-Open="_menuOpen" Label="@Action.Name">
            <ActionMenuLevel Actions="Action.SubActions" />
        </RelayMenu>
    }

    @if (Action.IsDisabled)
    {
        <FluentTooltip Anchor="@_id"
                       Positioning="Positioning.Before"
                       MaxWidth="300px">
            @Action.DisabledBecause
        </FluentTooltip>
    }

    @if (Action.NeedsConfirmation)
    {
        <ConfirmationPopover AnchorId="@_id" @bind-Opened="_confirmationOpen" OnConfirm="@Action.Action">
            Yes, I'm really sure
        </ConfirmationPopover>
    }
</div>
