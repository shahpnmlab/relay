@using Refund.DataModel
@using Refund.Services.Core.Session
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div style="display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            height: 100%">

    <div style="display: flex;
                flex-direction: column;
                align-items: center;
                row-gap: 8px;
                width: 100%;">

        <FluentButton id="buttonQueues"
                      IconStart="@(new Icons.Regular.Size24.BuildingFactory())"
                      Appearance="@(Session.CurrentOverlay == OverlayScreenType.Queues ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                      OnClick="OnQueuesButtonClick"
                      Title="Queues">
        </FluentButton>
        <FluentTooltip Anchor="buttonQueues" Positioning="Positioning.After">Queues</FluentTooltip>

        <FluentButton id="buttonPersonal"
                      IconStart="@(new Icons.Regular.Size24.Person())"
                      Appearance="@(Session.CurrentOverlay == OverlayScreenType.Personal ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                      OnClick="OnPersonalButtonClick"
                      Title="Personal settings">
        </FluentButton>
        <FluentTooltip Anchor="buttonPersonal" Positioning="Positioning.After">Personal settings</FluentTooltip>

        @if (Session.User.Role == UserRole.Admin)
        {
            <FluentButton id="buttonSettings"
                          IconStart="@(new Icons.Regular.Size24.Settings())"
                          Appearance="@(Session.CurrentOverlay == OverlayScreenType.Settings ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                          OnClick="OnSettingsButtonClick"
                          Title="Settings">
            </FluentButton>

            <FluentTooltip Anchor="buttonSettings" Positioning="Positioning.After">Settings</FluentTooltip>
        }

        <FluentButton id="buttonBrowseFiles"
                      IconStart="@(new Icons.Regular.Size24.FolderOpen())"
                      Appearance="ButtonAppearance.Subtle"
                      OnClick="OnBrowseFilesClick"
                      Title="Browse Files">
        </FluentButton>
        <FluentTooltip Anchor="buttonBrowseFiles" Positioning="Positioning.After">Browse Files</FluentTooltip>
    </div>

    <FluentButton id="buttonSignOut"
                  IconStart="@(new Icons.Regular.Size24.SignOut())"
                  Appearance="ButtonAppearance.Outline"
                  OnClick="@(() => _isSignOutOpen = !_isSignOutOpen)"
                  Title="Sign out"
                  Style="margin-bottom: 8px;">
    </FluentButton>
    <FluentTooltip Anchor="buttonSignOut" Positioning="Positioning.After">Sign out</FluentTooltip>
</div>

<ConfirmationPopover AnchorId="buttonSignOut" @bind-Opened="_isSignOutOpen"
                     PreferBefore="false" OnConfirm="Logout">
    Sign out
</ConfirmationPopover>
