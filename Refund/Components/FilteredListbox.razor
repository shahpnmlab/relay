@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@inherits ComponentBase
@typeparam TValue

<div class="filtered-list-container" style="width: @(ListWidth)px; max-width: 100%;">
    <FluentTextInput @bind-Value="_filterText"
                     Placeholder="@FilterPlaceholder"
                     Style="margin-bottom: 0px; border-radius: 0; width: 100%;"
                     Disabled="@Disabled"
                     Immediate="true"
                     Autofocus="true"
                     AutoComplete="off">
        <EndTemplate><FluentIcon Value="@(new Icons.Regular.Size16.Search())" /></EndTemplate>
    </FluentTextInput>

    <div class="listbox-options" style="max-height: @(ListHeight)px; overflow-y: auto;">
        <FluentListbox TOption="@((TValue Value, string Text))" TValue="TValue"
                       OptionValue="@(item => item.Value)" OptionText="@(item => item.Text)"
                       Items="@(Options.Where(opt => ShouldShowOption(opt.Text)))"
                       ValueChanged="@(v => OnValueChanged(v))"
                       Multiple="false"
                       Disabled="@Disabled"
                       Width="100%"
                       Autofocus="false"
                       Style="border-radius: 0;">
            <OptionTemplate Context="item">
                @if (HrefSelector != null)
                {
                    <a href="@HrefSelector(item.Value)"
                       style="text-decoration: none; color: inherit; display: block;"
                       @onclick:preventDefault
                       @onclick:stopPropagation
                       @onclick="@(async args => await OnOptionClicked.InvokeAsync((args, item.Value)))">
                        @if (OptionTemplate != null)
                        {
                            @OptionTemplate(item)
                        }
                        else
                        {
                            <span class="option-span" title="@item.Text">@item.Text</span>
                        }
                    </a>
                }
                else
                {
                    <div @onclick="@(() => OnValueChanged(item.Value))" @onclick:stopPropagation>
                        @if (OptionTemplate != null)
                        {
                            @OptionTemplate(item)
                        }
                        else
                        {
                            <span class="option-span" title="@item.Text">@item.Text</span>
                        }
                    </div>
                }
            </OptionTemplate>
        </FluentListbox>
    </div>
</div>
