<div>
    <FluentButton Id="@Id" Appearance="@Appearance" IconStart="@IconStart" IconEnd="@IconEnd"
                  Disabled="@Disabled" Class="@Class" Style="@Style" Title="@Title"
                  Color="@Color" BackgroundColor="@BackgroundColor"
                  OnClick="@(_ => _confirmationOpen = true)"
                  ChildContent="@ChildContent"
                  @attributes="AdditionalAttributes" />
    @if (_confirmationOpen)
    {
        <ConfirmationPopover AnchorId="@Id" @bind-Opened="_confirmationOpen" OnConfirm="HandleClick">
            Yes, I'm really sure
        </ConfirmationPopover>
    }
</div>
