@* Nothing, not even a hidden tooltip, is rendered while closed: FluentTooltip renders its content
   up front, which would build a full card for every line or dot that can show a preview *@
@if (Job != null)
{
    @* Out-of-flow, zero-size host keeps the tooltip element from taking part in the parent's
       flex/grid layout; the tooltip itself is fixed-positioned against its anchor *@
    <div class="job-preview-host">
        <RelayPopover @key="Job"
                       AnchorId="@Anchor"
                       Position="@(Position ?? Positioning.After)"
                       Opened="true"
                       OpenedChanged="HandleOpenedChanged"
                       Class="job-preview-popover">
            <div class="job-preview" @onclick:stopPropagation="true">
                @Renderer.Render(Job, DomIdSuffix)
            </div>
        </RelayPopover>
    </div>
}
