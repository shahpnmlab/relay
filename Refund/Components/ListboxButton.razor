@typeparam TValue

<ComboButton IconStart="@ButtonIconStart"
             MenuPosition="@ListPosition"
             IconEnd="@ButtonIconEnd"
             Loading="@ButtonLoading"
             Disabled="@ButtonDisabled"
             Appearance="@ButtonAppearance"
             Color="@ButtonColor"
             BackgroundColor="@ButtonBackgroundColor"
             ButtonMaxWidth="@ButtonMaxWidth"
             ButtonMinWidth="@ButtonMinWidth"
             OnClick="@OnClick"
             Href="@Href"
             Style="@ButtonStyle"
             @bind-IsOpen="_isOpen">
    <ChildContent>
        <span title="@ButtonLabel">@ButtonLabel</span>
    </ChildContent>
    <MenuContent>
        @if (IsFiltered)
        {
            <FilteredListbox TValue="TValue"
                             SelectedOptionChanged="@(v => OnListValueChanged(v))"
                             Options="@Options"
                             ListWidth="@ListWidth"
                             ListHeight="@ListHeight"
                             OptionTemplate="@OptionTemplate"
                             HrefSelector="@HrefSelector"
                             OnOptionClicked="@(async args => await HandleOptionLinkClick(args.Args, args.Value))"/>
        }
        else
        {
            <div class="filtered-list-container" style="width: @(ListWidth)px; max-width: 100%; max-height: @(ListHeight)px; overflow-y: auto;">
                <FluentListbox TOption="@((TValue Value, string Text))" TValue="TValue"
                       OptionValue="@(item => item.Value)" OptionText="@(item => item.Text)"
                               Items="@Options"
                               Multiple="false"
                               Disabled="@ButtonDisabled"
                               Width="100%"
                               ValueChanged="@(v => OnListValueChanged(v))">
                    <OptionTemplate Context="item">
                        <span slot="checked-indicator" hidden></span>
                        @if (HrefSelector != null)
                        {
                            <a class="option-content" href="@HrefSelector(item.Value)"
                               style="text-decoration: none; color: inherit; display: block;"
                               @onclick:preventDefault
                               @onclick:stopPropagation
                               @onclick="@(async args => await HandleOptionLinkClick(args, item.Value))">
                                @if (OptionTemplate != null)
                                {
                                    @OptionTemplate(item)
                                }
                                else
                                {
                                    <span class="option-span" title="@item.Text">@item.Text</span>
                                }
                            </a>
                        }
                        else
                        {
                            <div class="option-content" @onclick="@(() => OnListValueChanged(item.Value))" @onclick:stopPropagation>
                                @if (OptionTemplate != null)
                                {
                                    @OptionTemplate(item)
                                }
                                else
                                {
                                    <span class="option-span" title="@item.Text">@item.Text</span>
                                }
                            </div>
                        }
                    </OptionTemplate>
                </FluentListbox>
            </div>
        }
    </MenuContent>
</ComboButton>
