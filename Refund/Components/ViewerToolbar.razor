<div class="viewer-toolbar @Class" style="@Style" role="toolbar" aria-label="@AriaLabel">
    @ChildContent
</div>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Image viewer tools";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
