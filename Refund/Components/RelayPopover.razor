@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

<FluentPopover Id="@_id"
               AnchorId="@AnchorId"
               Opened="@(_mounted && Opened)"
               OpenedChanged="OpenedChanged"
               Class="@Class"
               Style="@Style">
    @ChildContent
</FluentPopover>

@code {
    [Parameter, EditorRequired] public string AnchorId { get; set; } = "";
    [Parameter] public bool Opened { get; set; }
    [Parameter] public EventCallback<bool> OpenedChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public Positioning Position { get; set; } = Positioning.BelowStart;
    [Parameter] public int Gap { get; set; }
    private readonly string _id = $"relay-popover-{Guid.NewGuid():N}";
    private bool _mounted;
    private bool _disposed;
    private bool _initializing;
    private IJSObjectReference? _module;
    private IJSObjectReference? _positioner;
    private (string Anchor, Positioning Position, int Gap)? _appliedPosition;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _initializing || (!firstRender && _appliedPosition == (AnchorId, Position, Gap))) return;
        _initializing = true;
        bool updateAgain = false;
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Refund/js/popover-position.js");
                if (_disposed) { await _module.DisposeAsync(); return; }
            }
            else if (_positioner is not null)
            {
                await _positioner.InvokeVoidAsync("dispose");
                await _positioner.DisposeAsync();
            }
            if (_disposed) return;
            _appliedPosition = (AnchorId, Position, Gap);
            _positioner = await _module!.InvokeAsync<IJSObjectReference>("initialize", _id, AnchorId, Position.ToString(), Gap);
            if (_disposed && _positioner is not null)
            {
                await _positioner.InvokeVoidAsync("dispose");
                await _positioner.DisposeAsync();
                return;
            }
            if (_disposed) return;
            // v5's web component opens in its attribute callback. Its first render must
            // attach it to the DOM before an open request can use the browser top layer.
            if (firstRender)
            {
                _mounted = true;
                if (Opened) StateHasChanged();
            }
            updateAgain = _appliedPosition != (AnchorId, Position, Gap);
        }
        finally
        {
            _initializing = false;
            if (!_disposed && updateAgain) StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_positioner is not null)
            {
                await _positioner.InvokeVoidAsync("dispose");
                await _positioner.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
