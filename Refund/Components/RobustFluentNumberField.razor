@typeparam TValue where TValue : new()

<FluentNumberInput TValue="TValue"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   Class="@Class"
                   Style="@Style"
                   Placeholder="@Placeholder"
                   Min="@ParseBound(Min, "Min")"
                   Max="@ParseBound(Max, "Max")"
                   Step="@ParseBound(Step, "Step")"
                   Immediate="@Immediate"
                   ImmediateDelay="@ImmediateDelay"
                   Disabled="@Disabled" />
