@using Relay.Emoji
<div class="@(Disabled ? "emoji-button-disabled" : "")">
    <div id="@_id" 
         style="@(ShowBorder ? "border: 1px solid var(--colorBrandBackground); border-radius: 10px; padding: 0.5rem;" : "")">
        @{
            var emoji = EmojiLibrary.FindByGlyph(Glyph)?.FluentEmoji;

            @if (emoji == null)
            {
                <FluentButton OnClick="@(_ => OpenEmojiSelector())" Disabled="@Disabled">
                    Select
                </FluentButton>
            }
            else
            {
                <FluentEmoji Value="emoji" Width="@(Size.HasValue ? $"{Size.Value}px" : null)" fill="none"
                             OnClick="@(_ => OpenEmojiSelector())"/>
            }
        }
    </div>

    <div class="popover-no-padding">
        <RelayPopover AnchorId="@_id"
                       Position="@Position"
                       @bind-Opened="@_isEmojiSelectorOpen">
            @if (_isEmojiSelectorOpen)
            {


                <div style="width: 316px;">
                    <EmojiSelector OnEmojiSelected="@HandleEmojiChanged"/>
                </div>


            }
        </RelayPopover>
    </div>
</div>
