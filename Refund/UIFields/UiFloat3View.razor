@namespace Refund.UIFields
@using System.Globalization
@using Warp.Tools
@inherits UiFieldViewBase

<FluentStack>
    <RobustFluentNumberField @bind-Value:get="ValueXT" @bind-Value:set="SetValueXTAsync" Style="width: 33%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueYT" @bind-Value:set="SetValueYTAsync" Style="width: 33%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueZT" @bind-Value:set="SetValueZTAsync" Style="width: 34%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))" 
                       Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiFloat3 FieldDescriptionT => (UiFloat3)FieldDescription ?? null;

    private float ValueXT => ((float3)EditingValue).X;

    private Task SetValueXTAsync(float value) => SetValueAsync(new float3(value, ((float3)EditingValue).Y, ((float3)EditingValue).Z));

    private float ValueYT => ((float3)EditingValue).Y;

    private Task SetValueYTAsync(float value) => SetValueAsync(new float3(((float3)EditingValue).X, value, ((float3)EditingValue).Z));

    private float ValueZT => ((float3)EditingValue).Z;

    private Task SetValueZTAsync(float value) => SetValueAsync(new float3(((float3)EditingValue).X, ((float3)EditingValue).Y, value));

    private string StepSizeToFormat(float stepSize)
    {
        var logStep = -(int)Math.Min(Math.Floor(Math.Log10((double)stepSize) + 1e-6), 0);

        return $"F{logStep}";
    }
}
