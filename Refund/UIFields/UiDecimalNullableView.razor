@namespace Refund.UIFields
@using System.Globalization
@inherits UiFieldViewBase

<RobustFluentNumberField
                   Class="borderless"
                   @bind-Value="@ValueT"
                   Style="width: 100%"
                   Placeholder="No value"
                   Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                   Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                   Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                   Disabled="@IsDisabled"/>

@code
{
    private UiDecimalNullable FieldDescriptionT => (UiDecimalNullable)FieldDescription ?? null;

    private decimal? ValueT
    {
        get => (decimal?)Value;
        set => ValueChanged.InvokeAsync(value);
    }
}
