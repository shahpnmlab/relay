@namespace Refund.UIFields
@inherits UiFieldViewBase

<RelayTextInput Class="borderless"
                 @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
                 Style="width: 100%"
                 Placeholder="No value"
                 Immediate="true"
                 Disabled="@IsDisabled" />

@code
{
    private UiString FieldDescriptionT => (UiString)FieldDescription ?? null;

    private string ValueT => (string)EditingValue ?? string.Empty;

    private Task SetValueTAsync(string value) => SetValueAsync(value);
}
