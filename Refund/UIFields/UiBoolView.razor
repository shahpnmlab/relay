@namespace Refund.UIFields
@inherits UiFieldViewBase

<FluentSelect TOption="SelectOption<string>" TValue="string" Class="borderless" Appearance="ListAppearance.Transparent"
              @bind-Value="@ValueT"
              Width="100%"
              Items="@Options"
              OptionText="@(i => i.Text)"
              OptionValue="@(i => i.Value)"
              Disabled="@IsDisabled" />

@code
{
    private string? ValueT
    {
        get => (bool)Value ? "Yes" : "No";
        set => ValueChanged.InvokeAsync(value == "Yes");
    }

    private List<SelectOption<string>> Options => new()
    {
        new SelectOption<string>() {Value = "Yes", Text = "Yes" },
        new SelectOption<string>() {Value = "No", Text = "No" },
    };
}
