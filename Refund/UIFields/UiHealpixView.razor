@namespace Refund.UIFields
@inherits UiFieldViewBase

<FluentSelect TOption="SelectOption<string>" TValue="string" @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
              Class="borderless" Appearance="ListAppearance.Transparent"
              Width="100%"
              Items="@Options"
              OptionText="@(i => i.Text)"
              OptionValue="@(i => i.Value)"
              Disabled="@IsDisabled"/>

@code
{
    private List<SelectOption<string>> Options = new()
    {
        new SelectOption<string>(){Text = "60 °", Value = "0" },
        new SelectOption<string>(){Text = "30 °", Value = "1" },
        new SelectOption<string>(){Text = "15 °", Value = "2" },
        new SelectOption<string>(){Text = "7.5 °", Value = "3" },
        new SelectOption<string>(){Text = "3.7 °", Value = "4" },
        new SelectOption<string>(){Text = "1.8 °", Value = "5" },
        new SelectOption<string>(){Text = "0.9 °", Value = "6" },
        new SelectOption<string>(){Text = "0.5 °", Value = "7" },
        new SelectOption<string>(){Text = "0.2 °", Value = "8" },
        new SelectOption<string>(){Text = "0.1 °", Value = "9" }
    };

    private UiHealpix FieldDescriptionT => (UiHealpix)FieldDescription ?? null;

    private string ValueT => Options[(int)EditingValue].Value;

    private Task SetValueTAsync(string value) => SetValueAsync(value == null ? 0 : int.Parse(value));
}