@using Refund.Components.FileBrowser
@using Refund.Services.Core.Session
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@namespace Refund.UIFields

@inherits UiFieldViewBase
@inject IDialogService DialogService
@inject RelaySession Session

<FluentStack HorizontalGap="0">
    <div style="width: 100%">
        <RelayTextInput @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
                         Class="borderless"
                         Immediate="true"
                         Style="width: 100%"
                         Placeholder="Use button to browse"
                         Disabled="@IsDisabled" />
    </div>

    <FluentButton IconEnd="@(new Icons.Filled.Size16.Folder())"
                  Title="Browse"
                  Style="margin-bottom: 4px; width: 40px"
                  OnClick="@OnBrowserButtonClick"
                  Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiPath FieldDescriptionT => (UiPath)FieldDescription ?? null;

    private string ValueT => (string)EditingValue ?? string.Empty;

    private Task SetValueTAsync(string value) => SetValueAsync(value);
    
    private async Task HandleDialog(DialogResult result)
    {
        if (result.Cancelled)
        {
            return;
        }
        if (result.Value is not null)
        {
            List<FileSystemItem> selectedItems = result.Value as List<FileSystemItem>;
            if (selectedItems.Any())
                await SetValueTAsync(selectedItems.First().Path);
            
            StateHasChanged();
        }
    }

    private async Task OnBrowserButtonClick()
    {
        string currentFolder = Session?.Space?.RootDirectory;
        string currentPath = ValueT;
        if (Directory.Exists(currentPath))
            currentFolder = Path.GetFullPath(currentPath);
        else if (File.Exists(currentPath))
            currentFolder = Path.GetDirectoryName(Path.GetFullPath(currentPath));

        await FileBrowserDialog.Show(DialogService, this, HandleDialog, "Select a file", 
                                     selectionMode: FieldDescriptionT.SelectionMode,
                                     allowedExtensions: FieldDescriptionT.FileExtensions.Any()
                                                            ? FieldDescriptionT.FileExtensions.ToArray()
                                                            : null,
                                     currentFolder: currentFolder);
    }
}
