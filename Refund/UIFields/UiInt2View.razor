@namespace Refund.UIFields
@using Warp.Tools
@inherits UiFieldViewBase

<FluentStack>
    <RobustFluentNumberField @bind-Value:get="ValueXT" @bind-Value:set="SetValueXTAsync"
                       Style="width: 50%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueYT" @bind-Value:set="SetValueYTAsync"
                       Style="width: 50%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true" 
                       Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiInt2 FieldDescriptionT => (UiInt2)FieldDescription ?? null;

    private int ValueXT => ((int2)EditingValue).X;

    private Task SetValueXTAsync(int value) => SetValueAsync(new int2(value, ((int2)EditingValue).Y));

    private int ValueYT => ((int2)EditingValue).Y;

    private Task SetValueYTAsync(int value) => SetValueAsync(new int2(((int2)EditingValue).X, value));
}
