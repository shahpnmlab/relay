@namespace Refund.UIFields
@inherits UiFieldViewBase

<RobustFluentNumberField
                   TValue="@(int?)"
                   @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
                   Style="width: 100%;"
                   Class="borderless"
                   Placeholder="No value"
                   Min="@(FieldDescriptionT.Min.ToString())"
                   Max="@(FieldDescriptionT.Max.ToString())"
                   Step="@(FieldDescriptionT.StepSize.ToString())"
                   Disabled="@IsDisabled" />

@code
{
    private UiIntNullable FieldDescriptionT => (UiIntNullable)FieldDescription ?? null;

    private int? ValueT => EditingValue == null ? null : (int?)EditingValue;

    private Task SetValueTAsync(int? value) => SetValueAsync(value);
}
