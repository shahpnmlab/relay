@namespace Refund.UIFields
@using System.Globalization
@using Warp.Tools
@inherits UiFieldViewBase

<FluentStack Style="align-items: center" HorizontalGap="5">
    <RobustFluentNumberField Class="borderless" 
                       @bind-Value:get="ValueLowerT" @bind-Value:set="SetValueLowerTAsync" Style="width: 50%"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString(CultureInfo.InvariantCulture))"
                       Max="@(ValueUpperT.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                       Disabled="@IsDisabled" />

    <span>—</span>

    <RobustFluentNumberField Class="borderless" 
                       @bind-Value:get="ValueUpperT" @bind-Value:set="SetValueUpperTAsync" Style="width: 50%"
                       Placeholder="No value"
                       Min="@(ValueLowerT.ToString(CultureInfo.InvariantCulture))"
                       Max="@(FieldDescriptionT.Max.ToString(CultureInfo.InvariantCulture))"
                       Step="@(FieldDescriptionT.StepSize.ToString(CultureInfo.InvariantCulture))"
                       Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiRange FieldDescriptionT => (UiRange)FieldDescription ?? null;

    private float ValueLowerT => ((float2)EditingValue).X;

    private Task SetValueLowerTAsync(float value) => SetValueAsync(new float2(value, ((float2)EditingValue).Y));

    private float ValueUpperT => ((float2)EditingValue).Y;

    private Task SetValueUpperTAsync(float value) => SetValueAsync(new float2(((float2)EditingValue).X, value));

    private string StepSizeToFormat(float stepSize)
    {
        var logStep = -(int)Math.Min(Math.Floor(Math.Log10((double)stepSize) + 1e-6), 0);

        return $"F{logStep}";
    }
}
