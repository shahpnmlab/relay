@namespace Refund.UIFields
@using Warp.Tools
@inherits UiFieldViewBase

<FluentStack>
    <RobustFluentNumberField @bind-Value:get="ValueXT" @bind-Value:set="SetValueXTAsync"
                       Style="width: 25%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueYT" @bind-Value:set="SetValueYTAsync"
                       Style="width: 25%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true" 
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueZT" @bind-Value:set="SetValueZTAsync"
                       Style="width: 25%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true" 
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueWT" @bind-Value:set="SetValueWTAsync"
                       Style="width: 25%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true" 
                       Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiInt4 FieldDescriptionT => (UiInt4)FieldDescription ?? null;

    private int ValueXT => ((int4)EditingValue).X;

    private Task SetValueXTAsync(int value) => SetValueAsync(new int4(value, ((int4)EditingValue).Y, ((int4)EditingValue).Z, ((int4)EditingValue).W));

    private int ValueYT => ((int4)EditingValue).Y;

    private Task SetValueYTAsync(int value) => SetValueAsync(new int4(((int4)EditingValue).X, value, ((int4)EditingValue).Z, ((int4)EditingValue).W));
    
    private int ValueZT => ((int4)EditingValue).Z;

    private Task SetValueZTAsync(int value) => SetValueAsync(new int4(((int4)EditingValue).X, ((int4)EditingValue).Y, value, ((int4)EditingValue).W));
    
    private int ValueWT => ((int4)EditingValue).W;

    private Task SetValueWTAsync(int value) => SetValueAsync(new int4(((int4)EditingValue).X, ((int4)EditingValue).Y, ((int4)EditingValue).Z, value));
}
