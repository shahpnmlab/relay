@namespace Refund.UIFields
@using Warp.Tools
@inherits UiFieldViewBase

<FluentStack>
    <RobustFluentNumberField @bind-Value:get="ValueXT" @bind-Value:set="SetValueXTAsync"
                       Style="width: 33%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true"
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueYT" @bind-Value:set="SetValueYTAsync"
                       Style="width: 33%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true" 
                       Disabled="@IsDisabled" />
    
    <RobustFluentNumberField @bind-Value:get="ValueZT" @bind-Value:set="SetValueZTAsync"
                       Style="width: 34%"
                       Class="borderless"
                       Placeholder="No value"
                       Min="@(FieldDescriptionT.Min.ToString())"
                       Max="@(FieldDescriptionT.Max.ToString())"
                       Step="@(FieldDescriptionT.StepSize.ToString())"
                       Immediate="true" 
                       Disabled="@IsDisabled" />
</FluentStack>

@code
{
    private UiInt3 FieldDescriptionT => (UiInt3)FieldDescription ?? null;

    private int ValueXT => ((int3)EditingValue).X;

    private Task SetValueXTAsync(int value) => SetValueAsync(new int3(value, ((int3)EditingValue).Y, ((int3)EditingValue).Z));

    private int ValueYT => ((int3)EditingValue).Y;

    private Task SetValueYTAsync(int value) => SetValueAsync(new int3(((int3)EditingValue).X, value, ((int3)EditingValue).Z));

    private int ValueZT => ((int3)EditingValue).Z;

    private Task SetValueZTAsync(int value) => SetValueAsync(new int3(((int3)EditingValue).X, ((int3)EditingValue).Y, value));
}
