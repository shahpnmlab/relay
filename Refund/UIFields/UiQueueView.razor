@using Refund.Services.Core.DataManager
@namespace Refund.UIFields
@inherits UiFieldViewBase
@inject DataManager DataManager

<FluentSelect TOption="SelectOption<string>" TValue="string" Class="borderless" Appearance="ListAppearance.Transparent"
              @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
              Width="100%"
              Items="@Options"
              OptionText="@(o => o.Text)"
              OptionValue="@(o => o.Value)"
              Disabled="@IsDisabled" />

@code
{
    private int CurrentId => EditingValue is int i ? i : -1;

    private string? ValueT => CurrentId.ToString();

    private Task SetValueTAsync(string? value) => SetValueAsync(value != null ? int.Parse(value) : -1);

    private List<SelectOption<string>> Options
    {
        get
        {
            var current = CurrentId;
            var includeLocal = (FieldDescription as UiQueue)?.IncludeLocal ?? true;
            var options = new List<SelectOption<string>>();

            if (includeLocal)
                options.Add(new() { Value = "-1", Text = "Local (no pool)", Selected = current == -1 });

            options.AddRange(DataManager.ClusterQueues.Select(q => new SelectOption<string>
            {
                Value    = q.Id.ToString(),
                Text     = string.IsNullOrWhiteSpace(q.Alias) ? $"Queue {q.Id}" : q.Alias,
                Selected = q.Id == current,
            }));

            return options;
        }
    }
}
