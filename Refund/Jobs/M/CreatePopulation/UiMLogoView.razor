@namespace Refund.UIFields
@using Refund.Jobs.M.CreatePopulation
@inherits UiFieldViewBase

<div style="width: 100%; display: flex; justify-content: center; align-items: center;">
    <img src="./_content/Refund/images/mlogo.png"
         style="max-width: 144px; max-height: 144px; filter: hue-rotate(@(ValueT)deg);" />
</div>

<FluentSlider
              TValue="@(int)"
              @bind-Value:get="ValueT" @bind-Value:set="SetValueTAsync"
              Style="width: 100%;"
              Min="-180"
              Max="180"
              Step="10"
              Disabled="@IsDisabled" />

@code
{
    private UiMLogo FieldDescriptionT => (UiMLogo)FieldDescription ?? null;

    private int ValueT => (int)EditingValue;

    private Task SetValueTAsync(int value) => SetValueAsync(value);
}