@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@rendermode InteractiveServer

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Default" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNav Id="main-menu" Width="250px" Title="Navigation menu">
            <FluentNavItem Href="/FileBrowser" Match="NavLinkMatch.All">FileBrowser</FluentNavItem>
            <FluentNavItem Href="/FileBrowserDialog" Match="NavLinkMatch.All">FileBrowserDialog</FluentNavItem>
            <FluentNavItem Href="/ComboButton" Match="NavLinkMatch.All">ComboButton</FluentNavItem>
            <FluentNavItem Href="/IsosurfaceViewer" Match="NavLinkMatch.All">IsosurfaceViewer</FluentNavItem>
            <FluentNavItem Href="/TomogramViewer" Match="NavLinkMatch.All">TomogramViewer</FluentNavItem>
            <FluentNavItem Href="/TomogramViewerJs" Match="NavLinkMatch.All">TomogramViewerJs</FluentNavItem>
            <FluentNavItem Href="/pluginstuff" Match="NavLinkMatch.All">Plugin Stuff</FluentNavItem>
            <FluentNavItem Href="/emoji" Match="NavLinkMatch.All">Emoji</FluentNavItem>
            <FluentNavItem Href="/scatterplot" Match="NavLinkMatch.All">SingleAxisScatter</FluentNavItem>
            <FluentNavItem Href="/fluent-migration">Fluent migration checks</FluentNavItem>
            <FluentNavItem Href="/histogram" Match="NavLinkMatch.All">Histogram</FluentNavItem>
        </FluentNav>
    </nav>
</div>
