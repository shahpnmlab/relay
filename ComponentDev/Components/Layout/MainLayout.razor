@using Refund.Components.GlobalTooltip
@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header"><header>ComponentDev</header></FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation"><NavMenu /></FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <main class="body-content"><div class="content">@Body</div></main>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Footer">
        <footer style="display: flex; gap: 16px;">
            <a href="https://www.fluentui-blazor.net" target="_blank">Documentation and demos</a>
            <FluentSpacer />
            <a href="https://learn.microsoft.com/en-us/aspnet/core/blazor" target="_blank">About Blazor</a>
        </footer>
    </FluentLayoutItem>
</FluentLayout>
<FluentProviders />
<GlobalTooltipContainer />

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
